<%= form_with model: [ :admin, cupcake ], class: "card", html: { style: "max-width:720px" } do |f| %>
  <%= required_fields_legend %>
  <% if cupcake.errors.any? %>
    <ul class="mensagens"><% cupcake.errors.map(&:message).uniq.each do |message| %><li class="msg-erro"><%= message %></li><% end %></ul>
  <% end %>
  <%= required_label f, :name, "Nome" %><%= f.text_field :name, required: true %>
  <%= required_label f, :category_id, "Categoria" %>
  <%= f.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: "Selecione…" }, required: true %>
  <%= required_label f, :description, "Descrição" %><%= f.text_area :description, rows: 3, required: true %>
  <%= f.label :ingredients, "Ingredientes" %><%= f.text_area :ingredients, rows: 2 %>
  <div class="duas" style="grid-template-columns:repeat(3,1fr);gap:10px">
    <div><%= required_label f, :price, "Preço (R$)" %><%= f.text_field :price, inputmode: "decimal", value: cupcake.price_before_type_cast, required: true %></div>
    <div><%= required_label f, :stock, "Estoque" %><%= f.number_field :stock, min: 0, required: true %></div>
    <div><%= required_label f, :min_stock, "Estoque mínimo" %><%= f.number_field :min_stock, min: 0, required: true %></div>
    <div><%= f.label :calories, "Calorias (kcal)" %><%= f.number_field :calories, min: 0 %></div>
    <div><%= f.label :fat_grams, "Gorduras (g)" %><%= f.text_field :fat_grams, inputmode: "decimal" %></div>
    <div><%= f.label :sugar_grams, "Açúcares (g)" %><%= f.text_field :sugar_grams, inputmode: "decimal" %></div>
  </div>
  <%= f.label :allergens, "Alérgenos (separados por vírgula)" %><%= f.text_field :allergens, placeholder: "Glúten, Lactose, Ovo" %>
  <%= f.label :photo_upload, "Foto do produto (JPG, PNG ou WebP, até 2 MB)" %>
  <div class="foto-produto">
    <% if cupcake.persisted? %><%= cupcake_image_tag(cupcake, alt: "Foto atual de #{cupcake.name}", width: 96, height: 96) %><% end %>
    <div>
      <%= f.file_field :photo_upload, accept: "image/jpeg,image/png,image/webp" %>
      <p class="ajuda" style="margin:4px 0 0"><%= cupcake.uploaded_photo? ? "Envie outra foto para trocar a atual." : "Sem foto enviada, a vitrine mostra a foto padrão do sabor ou uma ilustração na cor da cobertura." %></p>
    </div>
  </div>
  <%= f.label :color, "Cor da cobertura (ilustração)" %><%= f.color_field :color, style: "width:80px;height:44px;padding:4px" %>
  <p style="display:flex;gap:8px;margin-top:16px"><%= f.button "Salvar", class: "btn" %><%= link_to "Cancelar", admin_cupcakes_path, class: "btn sec" %></p>
<% end %>
