<% if cupcake.stock.positive? %>
  <%= form_with url: cart_items_path, class: "inline", style: "margin:8px 0 6px" do |f| %>
    <%= hidden_field_tag :cupcake_id, cupcake.id %>
    <%= f.label :quantity, "Qtd.", for: "qtd", style: "margin:0" %>
    <%= f.number_field :quantity, id: "qtd", value: 1, min: 1, max: cupcake.stock, style: "width:80px" %>
    <%= f.button "Adicionar ao carrinho", class: "btn" %>
  <% end %>
  <p class="ajuda"><%= cupcake.stock %> em estoque</p>
<% else %>
  <p class="selo">Esgotado</p>
<% end %>
<% if current_user&.customer? %>
  <%= button_to (current_user.favorited?(cupcake) ? "♥ Remover dos favoritos" : "♡ Favoritar"), cupcake_favorite_path(cupcake), class: "btn sec" %>
<% end %>
