<% content_for :title, "Entregas" %>
<h1>Minhas entregas</h1>
<% @orders.each do |order| %>
  <%= link_to courier_delivery_path(order), class: "card", style: "display:block;text-decoration:none;color:inherit;margin-bottom:10px" do %>
    <b>#<%= order.code %></b> · <%= order.customer.name %><br>📍 <%= order.delivery_address %><br>
    <span class="status <%= order.status %>"><%= order.status_label %></span>
  <% end %>
<% end %>
<% if @orders.empty? %>
  <div class="vazio">Nenhuma entrega em andamento. Os pedidos aparecem aqui quando a loja os envia para você.</div>
<% end %>
