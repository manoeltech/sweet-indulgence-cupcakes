<% content_for :title, "Meus pedidos" %>
<h1>Meus pedidos</h1>
<% if @orders.any? %>
  <div class="tabela"><table>
    <tr><th>Pedido</th><th>Data</th><th>Status</th><th>Total</th><th></th></tr>
    <% @orders.each do |order| %>
      <tr>
        <td>#<%= order.code %></td>
        <td><%= l order.created_at %></td>
        <td><span class="status <%= order.status %>"><%= order.status_label %></span></td>
        <td><%= brl order.total %></td>
        <td><%= link_to "Ver", order_path(order) %></td>
      </tr>
    <% end %>
  </table></div>
<% else %>
  <div class="vazio"><p>Você ainda não fez nenhum pedido.</p><%= link_to "Ver vitrine", root_path, class: "btn" %></div>
<% end %>
